# Runtime configuration only; never commit .env
YV_MODELS_DIR=models
YV_OUTPUT_DIR=outputs/runs
YV_CONFIG=configs/default.yaml
YV_PRIVACY_BLUR_PLATES=true
YV_PRIVACY_BLUR_MODE=plate_region
YV_PRIVACY_ALLOW_UNBLURRED=false
YV_TRUSTED_MODELS_ONLY=true

# docker-compose secrets. Set these in your shell or an untracked .env file;
# compose refuses to start when a required value is missing.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# API_KEYS_JSON=
# MEDIA_SIGNING_KEY=
