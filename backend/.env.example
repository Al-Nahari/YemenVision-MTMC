DATABASE_URL=sqlite:///./traffic_platform.db
# Development template only. Use a private random key in backend/.env; never commit it.
API_KEYS_JSON={"replace-with-private-random-key":{"subject":"local-admin","roles":["admin","operator","analyst"]}}
RATE_LIMIT_PER_MINUTE=120
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=video-artifacts
RETENTION_DAYS=30
YV_QUEUE_BACKEND=local
YV_REDIS_URL=redis://localhost:6379/0
YV_REDIS_QUEUE=yemenvision:video-jobs

# Model registry (read-only). Production must use a manifest-verified detector.
YV_MODELS_DIR=../models
YV_TRUSTED_MODELS_ONLY=true
# YV_DETECTOR_MODEL=detector_best.pt

# Uploads and media
YV_MAX_UPLOAD_BYTES=524288000
MEDIA_SIGNING_KEY=replace-with-a-long-random-secret
MEDIA_URL_TTL_SECONDS=3600
YV_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4173,http://127.0.0.1:4173

# Privacy: plate numbers are stored in the data logs by default.
# Enable blur only for deployments that must redact the saved video.
YV_PRIVACY_BLUR_PLATES=false
YV_PRIVACY_BLUR_MODE=off
YV_PRIVACY_ALLOW_UNBLURRED=true

# CPU budget. Lower the width on weak machines; OCR is lazy and throttled.
YV_MAX_INFER_WIDTH=960
YV_PLATE_OCR_ENABLED=true
YV_PLATE_OCR_MAX_PER_FRAME=4
YV_PLATE_OCR_MIN_CONFIDENCE=0.55
